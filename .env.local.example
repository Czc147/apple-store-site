# ============================================================
# 环境变量模板
# 使用方法：复制本文件为 .env.local 并填入真实值
#   Windows:  copy .env.local.example .env.local
#   macOS:  cp .env.local.example .env.local
# 获取位置：Supabase Dashboard → Project Settings → API
# ============================================================

# 项目 API 地址（形如 https://abcdefgh.supabase.co）
SUPABASE_URL=https://your-project-ref.supabase.co

# 匿名公钥（可暴露给浏览器，仅用于前台只读查询）
SUPABASE_ANON_KEY=your-anon-public-key

# 服务端密钥（绕过 RLS，仅用于 API Routes / Netlify Functions）
# ⚠️ 严禁出现在任何客户端代码或前端打包产物中
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 后台管理（/admin）登录密码
# - 登录后写入 7 天有效期的 httpOnly cookie
# - 同时用作会话签名密钥，请设置足够复杂的字符串
# ⚠️ Netlify 部署时请在 Site settings → Environment variables 中同步配置
ADMIN_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------
# 用户登录（邮箱+密码，Supabase Auth）必需：
# 浏览器端 supabase-js 用带 NEXT_PUBLIC_ 前缀的公钥（值与上面相同）。
# ⚠️ 构建期内联，修改后必须重新构建/部署（Netlify 需重新触发构建）。
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
